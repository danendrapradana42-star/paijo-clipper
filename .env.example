# GEMINI_API_KEY: Required for Gemini AI API calls (/api/transcribe, /api/ai-video/*, /api/clips/highlights).
# AI Studio automatically injects this from user secrets.
# On Vercel: add GEMINI_API_KEY in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (optional on Vercel; Vercel provides VERCEL_URL automatically).
APP_URL="MY_APP_URL"

# DESKTOP_GITHUB_REPO: GitHub repository (owner/repo) hosting Paijo Clip Windows .exe releases.
# On Vercel connected to GitHub, VERCEL_GIT_REPO_OWNER + VERCEL_GIT_REPO_SLUG are detected automatically.
DESKTOP_GITHUB_REPO=""

# Optional direct HTTPS download URLs for Windows Setup (.exe) & Portable (.exe) installers
DESKTOP_SETUP_EXE_URL=""
DESKTOP_PORTABLE_EXE_URL=""
